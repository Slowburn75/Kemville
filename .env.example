# Neon pooled runtime URL; never put these variables in NEXT_PUBLIC_*
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/kemville?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/kemville?sslmode=require
APP_URL=http://localhost:3000
AUTH_SECRET=
# 32 random bytes encoded as hex; keep versioned keys for rotation
MEDICAL_ENCRYPTION_KEY=
MEDICAL_ENCRYPTION_KEY_VERSION=1
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_MEET_ENABLED=false
GOOGLE_PRIVACY_REVIEW_APPROVED=false
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_BUSINESS_NUMBER=
CRON_SECRET=
ALLOW_DEV_SEED=false
# Requires approved policies, clinician verification and operational review
REGISTRATION_APPROVED=false
PRIVACY_POLICY_VERSION=
